# Salin ke .env lalu ISI semua nilai. Jangan commit .env.
# Buat secret: openssl rand -hex 32
SOC_INGEST_TOKEN=
SESSION_SECRET=
SOC_ADMIN_USER=admin
SOC_ADMIN_PASSWORD=
# IP LAN VM Debian (disarankan) atau 0.0.0.0
BIND_IP=
SERVER_NAME=_
# Opsional: mirror npm jika registry.npmjs.org tidak terjangkau
# NPM_REGISTRY=https://registry.npmjs.org/
